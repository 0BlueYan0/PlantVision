#usda 1.0
(
    customLayerData = {
        string creator = "Codex + Reality Composer Pro Version 2.0 (494.100.6)"
        string markerTemplateNotes = "Reusable 3D flower and leaf callout markers. Halo is represented as animated emissive particles using standard USD spheres."
    }
    defaultPrim = "Root"
    endTimeCode = 180
    framesPerSecond = 60
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 60
    upAxis = "Y"
)

def Xform "Root"
{
    def Scope "Materials"
    {
        def Material "FlowerGlowMaterial"
        {
            token outputs:surface.connect = </Root/Materials/FlowerGlowMaterial/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1.0, 0.32, 0.58)
                color3f inputs:emissiveColor = (3.4, 0.9, 1.75)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.18
                token outputs:surface
            }
        }

        def Material "FlowerHaloMaterial"
        {
            token outputs:surface.connect = </Root/Materials/FlowerHaloMaterial/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1.0, 0.48, 0.28)
                color3f inputs:emissiveColor = (2.8, 1.25, 0.55)
                float inputs:metallic = 0
                float inputs:opacity = 0.72
                float inputs:roughness = 0.08
                token outputs:surface
            }
        }

